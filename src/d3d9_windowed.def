; Export the undecorated names a d3d9 client expects. Without this, __stdcall
; exports would be decorated (_Direct3DCreate9@4) and the game would fail to bind.
LIBRARY d3d9
EXPORTS
    Direct3DCreate9
    Direct3DCreate9Ex
    DebugSetMute
    D3DPERF_BeginEvent
    D3DPERF_EndEvent
    D3DPERF_SetMarker
    D3DPERF_SetRegion
    D3DPERF_QueryRepeatFrame
    D3DPERF_SetOptions
    D3DPERF_GetStatus
